# StyleFlo environment variable names (STYL-210).
# Copy via `npm run env:local` after `npx supabase start` — do NOT paste live values.
# This file lists names only (no secrets). Values marked [TEST KEYS ONLY] must never
# be live production credentials on a developer machine.

# ---------------------------------------------------------------------------
# App environment
# ---------------------------------------------------------------------------
# development | test | staging | production
# Production Cloud Run today relies on NODE_ENV=production when APP_ENV is unset.
APP_ENV=
NODE_ENV=
NEXT_PUBLIC_ENV=
PLAYWRIGHT_TEST=
CI=
DISABLE_ONBOARDING_BOT=

# ---------------------------------------------------------------------------
# Supabase (local CLI: http://127.0.0.1:54321 — never the live project on a dev machine)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Public app URLs
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=
APP_URL=
WORDPRESS_SITE_URL=

# ---------------------------------------------------------------------------
# Analytics / pixels (public)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# ---------------------------------------------------------------------------
# AI / LLM  [TEST KEYS ONLY on a developer machine]
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_AI_API_KEY=
GOOGLE_API_KEY=
DEFAULT_GEMINI_MODEL=
GEMINI_MODEL=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Stripe  [TEST KEYS ONLY on a developer machine — use sk_test_…]
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Mailgun  [TEST KEYS ONLY / mock on a developer machine]
# ---------------------------------------------------------------------------
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# ---------------------------------------------------------------------------
# Twilio  [TEST KEYS ONLY on a developer machine]
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_COUNTRY=
TWILIO_ADDRESS_SID=
TWILIO_ADDRESS_SID_LOCAL=
TWILIO_BUNDLE_SID=
TWILIO_BUNDLE_SID_LOCAL=
TWILIO_BUNDLE_SID_MOBILE=
TWILIO_LOCAL_BUNDLE_SID=
TWILIO_MOBILE_BUNDLE_SID=

# ---------------------------------------------------------------------------
# Vapi  [TEST KEYS ONLY on a developer machine]
# ---------------------------------------------------------------------------
VAPI_API_KEY=
VAPI_PRIVATE_API_KEY=
VAPI_PRIVATE_KEY=
VAPI_SECRET_KEY=
VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
VAPI_MASTER_ASSISTANT_ID=

# ---------------------------------------------------------------------------
# ElevenLabs  [TEST KEYS ONLY on a developer machine]
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEY=
XI_API_KEY=

# ---------------------------------------------------------------------------
# Cloudflare Turnstile  [TEST KEYS ONLY on a developer machine]
# ---------------------------------------------------------------------------
TURNSTILE_SECRET_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Per-IP ceiling for magic-link and check-email, per 15 minutes.
# Leave unset in production (default 20). Playwright sets a high value in .env.test only.
AUTH_RATE_LIMIT_PER_IP=

# ---------------------------------------------------------------------------
# Meta / WhatsApp  [TEST KEYS ONLY on a developer machine]
# ---------------------------------------------------------------------------
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_BASE_URL=
META_GRAPH_VERSION=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_TOKEN=
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_ES_CONFIG_ID=
NEXT_PUBLIC_META_GRAPH_VERSION=

# ---------------------------------------------------------------------------
# Google OAuth / Places / Maps  [TEST KEYS ONLY on a developer machine]
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_SERVER_API_KEY=
GOOGLE_PLACES_HTTP_REFERER=
GCP_PROJECT_ID=
GOOGLE_CLOUD_PROJECT=

# ---------------------------------------------------------------------------
# Microsoft / Azure OAuth  [TEST KEYS ONLY on a developer machine]
# ---------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Security / signing secrets  [TEST KEYS ONLY on a developer machine]
# ---------------------------------------------------------------------------
CHAT_SESSION_SIGNING_SECRET=
TOKEN_ENC_KEY=
CRON_SECRET=
OPENCLAW_BEARER_TOKEN=
WPMUDEV_WEBHOOK_SECRET=
STYLEFLO_WP_API_SECRET=
STYLEFLO_WP_CREATE_BUSINESS_TOKEN=

# ---------------------------------------------------------------------------
